{
  "name": "todo-repuestos-la-61",
  "version": "1.2.0",
  "description": "TODO REPUESTOS Y FRENOS LA 61 - Tienda de repuestos para vehiculos livianos (Vite + Express + MySQL)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"node scripts/wait-api.js && npm run client\"",
    "client": "vite --open",
    "server": "nodemon server.js",
    "start": "node server.js",
    "build": "vite build",
    "db:init": "node db/init.js",
    "db:imagenes": "node db/migrate-imagenes.js",
    "db:asesores": "node db/migrate-asesores.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "vite": "^5.4.2"
  }
}
